# Focalyze — Environment Variables
# Copy this file to .env and fill in your values

# ─── AWS HealthLake (optional — for clinical data integration) ───────────────
VITE_AWS_REGION=us-east-1
VITE_HEALTHLAKE_DATASTORE_ID=

# ─── OpenRouter AI (optional — for AI-powered features) ─────────────────────
VITE_OPENROUTER_API_KEY=

# ─── App Config ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Focalyze
VITE_APP_URL=https://focalyze.vercel.app
